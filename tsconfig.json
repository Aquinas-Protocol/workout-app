{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Overriding exclude replaces Expo's base list, so it is repeated here;
  // server/ is the Cloudflare Worker with its own tsconfig.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "server"
  ]
}
